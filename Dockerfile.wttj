FROM mcr.microsoft.com/playwright/python:v1.40.0-jammy

WORKDIR /app

# Install dependencies
COPY services/wttj/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt psycopg2-binary sqlalchemy

# Install Playwright browsers (Firefox specifically needed)
RUN playwright install firefox
RUN playwright install-deps

# Copy shared library
COPY ./shared ./shared

# Copy the WTTJ service
COPY ./services/wttj ./services/wttj

# Ensure screenshots and profile directories exist
RUN mkdir -p screenshots firefox_profile

EXPOSE 8012

# Ensure xvfb is installed for headed bypass
RUN apt-get update && apt-get install -y xvfb && rm -rf /var/lib/apt/lists/*

# Run Uvicorn wrapped in xvfb-run to provide a virtual display
CMD ["xvfb-run", "-a", "--server-args=-screen 0 1920x1080x24", "python", "-m", "uvicorn", "services.wttj.app.main:app", "--host", "0.0.0.0", "--port", "8012"]
